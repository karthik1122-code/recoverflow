# Use Razorpay TEST mode credentials only. Never commit the real .env file.
RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_SECRET=...
RAZORPAY_WEBHOOK_SECRET=choose-a-long-random-value
# Live money is opt-in. With rzp_live_ keys you must also set RAZORPAY_MODE=live.
# RAZORPAY_MODE=live
PORT=4173
# Store name shown in the customer message preview
MERCHANT_NAME=Your Store
# Public demo service URL; /demo on this server forwards there
# DEMO_URL=https://recoverflow-demo.onrender.com
# DEMO=on with AUTH=off runs the public demo: sample cases, simulated links, no keys
# DEMO=on
# AUTH=off
